<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<appSettings>
		<add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
		
	</appSettings>

	<connectionStrings>
		<add name="ExpoPanelDB"
			 connectionString="Data Source=115.124.106.157;Initial Catalog=eventExpo;User ID=eventExpo;Password=Expo@123@321#;MultipleActiveResultSets=True;TrustServerCertificate=True"
			 providerName="System.Data.SqlClient" />
			<!--<add name="ExpoPanelDB"
				 connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=eventExpo;Integrated Security=True;TrustServerCertificate=True;"
				 providerName="System.Data.SqlClient" />-->

	</connectionStrings>


	<system.web>
		<pages enableSessionState="true" />

		<machineKey
			validationKey="A5A35874281729C481A014496B3E3C8B3C00846560B05F7B59453F053151D83E3CC91B4C937A991E21C9414B3330F7C73347E28E954B5262E1989F9514F69584"
			decryptionKey="F9A5D6D472F2921D9D99F3E752835565A3F83C564FEA842E"
			validation="SHA1"
			decryption="AES" />

		<!-- debug=false prevents automatic app restarts during development -->
		<compilation debug="false" />

		<httpRuntime maxRequestLength="51200" executionTimeout="300" />

		<!-- Long forms auth cookie (1 day) + slidingExpiration -->
		<authentication mode="Forms">
			<forms loginUrl="Default.aspx"
				   timeout="1440"
				   slidingExpiration="true" />
		</authentication>

		<!-- DO NOT USE InProc for long sessions -->
		<!-- StateServer survives restarts and gives almost "no expire" -->
		<sessionState mode="StateServer"
					  stateConnectionString="tcpip=127.0.0.1:42424"
					  cookieless="false"
					  timeout="1440" />

		<customErrors mode="Off" />
	</system.web>

	<system.webServer>
		<security>
			<requestFiltering>
				<requestLimits maxAllowedContentLength="52428800" />
			</requestFiltering>
		</security>
	</system.webServer>


	<!--<system.codedom>
		<compilers>
			<compiler language="c#;cs;csharp" extension=".cs"
					  type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider,
                      Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0,
                      Culture=neutral, PublicKeyToken=31bf3856ad364e35"
					  warningLevel="4"
					  compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
		</compilers>
	</system.codedom>-->
</configuration>
